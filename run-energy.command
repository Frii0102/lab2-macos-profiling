#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
echo 'Енерговимірювання займе приблизно 4 хвилини. Збережи свою роботу.'
echo 'Закрий важкі програми. Не змінюй зарядку, яскравість і режим живлення.'
echo 'Пароль Mac вводиться тут; символи пароля не відображаються. Не надсилай його в чат.'
sudo -v
/usr/bin/python3 energy.py
echo 'Завершено. Надішли повідомлення «енергія готова» — додамо результати до звіту.'
read -r -p 'Натисни Enter, щоб закрити...' answer
